          "auto_advance": { "type": "boolean" },
          "collection_method": { "type": "string", "enum": ["charge_automatically", "send_invoice"] },
          "due_date": { "type": "integer", "nullable": true },
          "hosted_invoice_url": { "type": "string", "nullable": true, "description": "Public Stripe-hosted page where the customer can pay." },
          "invoice_pdf": { "type": "string", "nullable": true },
          "number": { "type": "string", "nullable": true, "description": "Human-readable invoice number." },
          "paid": { "type": "boolean" },
          "period_start": { "type": "integer" },
          "period_end": { "type": "integer" },
          "total": { "type": "integer" },
          "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "InvoiceCreateInput": {
        "type": "object",
        "required": ["customer"],
        "properties": {
          "customer": { "type": "string", "description": "Customer id `cus_*`." },
          "auto_advance": { "type": "boolean", "description": "TRUE → Stripe finalises and attempts collection automatically. FALSE (default) → invoice stays as a draft until you call `invoicesPay` or finalise it via the dashboard." },
          "collection_method": { "type": "string", "enum": ["charge_automatically", "send_invoice"] },
          "days_until_due": { "type": "integer", "description": "Required if `collection_method: send_invoice`." },
          "description": { "type": "string" },
          "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "InvoicePayInput": {
        "type": "object",
        "properties": {
          "payment_method": { "type": "string", "description": "Payment method id (`pm_*`) to charge — defaults to the customer's default." },
          "off_session": { "type": "boolean", "description": "TRUE for unattended collection (no SCA challenge possible)." }
        }
      },
      "InvoiceList": {
        "type": "object",
        "properties": {
          "object": { "type": "string", "enum": ["list"] },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Invoice" } },
          "has_more": { "type": "boolean" }
        }
      },
      "InvoiceItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
