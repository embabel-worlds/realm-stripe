          "currency": { "type": "string" },
          "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "PaymentLinkInput": {
        "type": "object",
        "required": ["line_items"],
        "properties": {
          "line_items": {
            "type": "array",
            "description": "Each line: `{price: \"price_*\", quantity: 1}`.",
            "items": {
              "type": "object",
              "required": ["price", "quantity"],
              "properties": {
                "price": { "type": "string" },
                "quantity": { "type": "integer", "minimum": 1 },
                "adjustable_quantity": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "minimum": { "type": "integer" },
                    "maximum": { "type": "integer" }
                  }
                }
              }
            }
          },
          "metadata": { "type": "object", "additionalProperties": { "type": "string" } },
          "after_completion": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["hosted_confirmation", "redirect"] },
              "redirect": { "type": "object", "properties": { "url": { "type": "string" } } }
            }
          },
          "allow_promotion_codes": { "type": "boolean" }
        }
      }
    }
  }
}
