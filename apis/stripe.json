          },
          "payment_intent": { "type": "string", "nullable": true },
          "payment_method": { "type": "string", "nullable": true },
          "payment_method_details": { "type": "object", "nullable": true },
          "receipt_url": { "type": "string", "nullable": true },
          "created": { "type": "integer" },
          "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "ChargeList": {
        "type": "object",
        "properties": {
          "object": { "type": "string", "enum": ["list"] },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Charge" } },
          "has_more": { "type": "boolean" }
        }
      },
      "ChargeSearchResult": {
        "type": "object",
        "properties": {
          "object": { "type": "string", "enum": ["search_result"] },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Charge" } },
          "has_more": { "type": "boolean" },
          "next_page": { "type": "string", "nullable": true }
        }
      },
      "Refund": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Prefixed `re_*`." },
