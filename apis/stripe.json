          "price": { "$ref": "#/components/schemas/Price" },
          "quantity": { "type": "integer" }
        }
      },
      "InvoiceItemInput": {
        "type": "object",
        "required": ["customer"],
        "properties": {
          "customer": { "type": "string" },
