          "source_types": { "type": "object" }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Prefixed `prod_*`." },
          "object": { "type": "string", "enum": ["product"] },
          "name": { "type": "string" },
