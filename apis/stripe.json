          "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "RefundInput": {
        "type": "object",
        "required": ["charge"],
        "properties": {
          "charge": { "type": "string", "description": "Charge id `ch_*` to refund." },
          "amount": { "type": "integer", "description": "Minor units. Omit to refund in full." },
