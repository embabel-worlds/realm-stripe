          "reverse_transfer": { "type": "boolean" },
          "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "Payout": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Prefixed `po_*`." },
          "object": { "type": "string", "enum": ["payout"] },
