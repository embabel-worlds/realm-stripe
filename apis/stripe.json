          "arrival_date": { "type": "integer", "description": "Unix seconds — date funds land in your bank." },
          "currency": { "type": "string" },
          "status": { "type": "string", "enum": ["paid", "pending", "in_transit", "canceled", "failed"] },
          "method": { "type": "string", "enum": ["standard", "instant"] },
          "type": { "type": "string", "enum": ["bank_account", "card"] },
          "description": { "type": "string", "nullable": true },
          "created": { "type": "integer" }
        }
      },
      "PayoutList": {
        "type": "object",
        "properties": {
          "object": { "type": "string", "enum": ["list"] },
