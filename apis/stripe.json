            "type": "object",
            "nullable": true,
            "properties": {
              "interval": { "type": "string", "enum": ["day", "week", "month", "year"] },
              "interval_count": { "type": "integer" },
              "usage_type": { "type": "string", "enum": ["licensed", "metered"] }
            }
          },
          "nickname": { "type": "string", "nullable": true },
          "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "PriceList": {
        "type": "object",
        "properties": {
          "object": { "type": "string", "enum": ["list"] },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Price" } },
          "has_more": { "type": "boolean" }
        }
      },
      "PaymentLink": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Prefixed `plink_*`." },
